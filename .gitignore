# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# RepoAtlas local state (the index is derived data, never source)
*.db
*.db-wal
*.db-shm

# Graph explorer (frontend/): installed packages, builds, local settings and test
# output. Listed here, not in frontend/.gitignore, because hatchling builds the
# sdist from this file alone.
frontend/node_modules/
frontend/.next/
frontend/.next-e2e/
frontend/.next-ui/
frontend/out/
# The export staged into the package by a release build (see pyproject.toml).
repoatlas/ui/explorer/
frontend/next-env.d.ts
frontend/*.tsbuildinfo
frontend/.env*.local
frontend/test-results/
frontend/playwright-report/

# Playwright MCP output
.playwright-mcp/

# A developer's own Claude Code settings (settings.local.json is personal by design)
.claude/settings.local.json
